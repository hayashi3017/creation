
# PostgreSQL
POSTGRES_DB=creation
POSTGRES_USER=hayashi3017
POSTGRES_PASSWORD=password

# sqlx
# valid, see: https://matsuand.github.io/docs.docker.jp.onthefly/desktop/windows/networking/#use-cases-and-workarounds
DATABASE_URL=postgres://hayashi3017:password@host.docker.internal:5432/creation
# valid, direct
# DATABASE_URL=postgres://hayashi3017:password@db:3306/creation
SQLX_OFFLINE=true

# jwt
JWT_SECRET=my_ultra_secure_secret
JWT_EXPIRED_IN=60m
JWT_MAXAGE=60

# mode
# RUNTIME_MODE=debug

